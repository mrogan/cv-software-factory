{
  "uid": "overview",
  "title": "Overview",
  "description": "Is the factory healthy right now, and if not, where? The app against its objectives, the line, spend against the caps, and the platform; each tile opens its dashboard.",
  "tags": ["software-factory"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": ["software-factory"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Releases",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#9085e9",
        "expr": "sum by (outcome) (changes(line_releases_total{dry_run=\"false\"}[2m])) > 0",
        "step": "1m",
        "titleFormat": "Release {{outcome}}",
        "textFormat": "The line recorded a release’s end",
        "tagKeys": "outcome",
        "useValueForTime": false
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#3987e5",
        "expr": "sum by (name) (changes(argocd_app_sync_total{phase=\"Succeeded\"}[2m])) > 0",
        "step": "1m",
        "titleFormat": "Argo CD synced {{name}}",
        "textFormat": "",
        "tagKeys": "name",
        "useValueForTime": false
      },
      {
        "name": "The app’s alerts",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertstate=\"firing\", objective!=\"\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{route}}",
        "tagKeys": "objective,route",
        "useValueForTime": false
      }
    ]
  },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "The app",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors, worst route",
      "description": "The share of requests answered with a 5xx status over 15 minutes, on the route with the most, among routes with at least 20 requests: what the error alert judges. Good is under the objective, 5%.",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(((sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\", http_response_status_code=~\"5..\"}[15m])) or (sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}[15m])) * 0)) / sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}[15m]))) and on (http_route) (sum by (http_route) (increase(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}[15m])) >= 20))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 0.025 },
              { "color": "#d03b3b", "value": 0.05 }
            ]
          },
          "links": [{ "title": "The app", "url": "/d/website?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95, slowest route",
      "description": "The 95th percentile of response time over 15 minutes, on the slowest route with at least 20 requests: what the latency alert judges. Good is under the objective, 1 s.",
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}[15m]))) and on (http_route) (sum by (http_route) (increase(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}[15m])) >= 20))"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 0.5 },
              { "color": "#d03b3b", "value": 1 }
            ]
          },
          "links": [{ "title": "The app", "url": "/d/website?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts firing",
      "description": "The app’s alerts firing now, one for each route and objective broken for two minutes. Good is none.",
      "gridPos": { "x": 10, "y": 1, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\", objective!=\"\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No answer from Prometheus",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#d03b3b", "value": 1 }
            ]
          },
          "links": [{ "title": "The app", "url": "/d/website?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error budget left, 7 days",
      "description": "How much of each objective’s error budget the last seven days left: 5% of requests may fail, and 5% may be slower than 1 s. 100% is all of it; below 0 is overspent. The app is broken on purpose, so it is overspent while its faults stand.",
      "gridPos": { "x": 14, "y": 1, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_remaining:ratio7d",
          "instant": true,
          "range": false,
          "legendFormat": "{{objective}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "No requests in 7 days",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 0 },
              { "color": "#0ca30c", "value": 0.25 }
            ]
          },
          "links": [{ "title": "The app", "url": "/d/website?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rollout",
      "description": "Where the app’s Rollout is: stable, a canary in progress, or a canary aborted, which Argo Rollouts does when its analysis fails. Good is stable, or a canary on its way.",
      "gridPos": { "x": 19, "y": 1, "w": 5, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(rollout_phase{namespace=\"website\", name=\"website\", phase=~\"Progressing|Paused\"}) + 2 * max(rollout_phase{namespace=\"website\", name=\"website\", phase=~\"Abort|Error|Timeout\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Argo Rollouts not reporting",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#898781", "value": 1 },
              { "color": "#d03b3b", "value": 2 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Stable", "index": 0 },
                "1": { "text": "Canary", "index": 1 },
                "2": { "text": "Aborted", "index": 2 },
                "3": { "text": "Aborted", "index": 3 }
              }
            }
          ],
          "links": [{ "title": "The app", "url": "/d/website?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "The line",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Work in progress",
      "description": "Work items on the line now, at every stage but held. None is fine: the line takes a ticket when there is one.",
      "gridPos": { "x": 0, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(line:work_items:max{stage!=\"held\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "The line is off",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Nearest its limit",
      "description": "How long the work item longest at its stage has been there, as a share of that stage’s limit, for the stage nearest its limit. Past 100% the line is stuck there. Waiting and held have no limit.",
      "gridPos": { "x": 4, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(line:stage_oldest:ratio_to_limit)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "The line is off",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 0.75 },
              { "color": "#d03b3b", "value": 1 }
            ]
          },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Held for Martin",
      "description": "Work items waiting for Martin’s answer. Good is none; one is the line asking, not failing.",
      "gridPos": { "x": 8, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(line:work_items:max{stage=\"held\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "The line is off",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 1 }
            ]
          },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Steps done",
      "description": "The share of agents’ steps that ended done in the range, of all that ended. A step that failed runs again, so a few are expected; under half is a line going round in circles.",
      "gridPos": { "x": 12, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(line_steps_total{outcome=\"done\"}[$__range])) / sum(increase(line_steps_total[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "No steps in this range",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#d03b3b", "value": 0 },
              { "color": "#fab219", "value": 0.5 },
              { "color": "#0ca30c", "value": 0.8 }
            ]
          },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Last step",
      "description": "How long since an agent’s step last ended, within the last seven days. The line can be idle for hours: that is no fault on its own.",
      "gridPos": { "x": 16, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - max(max_over_time((timestamp(increase(line_steps_total[2m]) > 0))[7d:1m]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "None in 7 days",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Releases",
      "description": "Releases of the app the line saw end in the range, by how they ended: promoted, rolled back, aborted or errored. Dry runs are left out.",
      "gridPos": { "x": 20, "y": 5, "w": 4, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (round(increase(line_releases_total{dry_run=\"false\"}[$__range])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{outcome}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No releases in this range",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "links": [{ "title": "The line", "url": "/d/line?${__url_time_range}" }]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "promoted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byName", "options": "rolled-back" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          },
          {
            "matcher": { "id": "byName", "options": "aborted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#898781" } }]
          },
          {
            "matcher": { "id": "byName", "options": "errored" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#ec835a" } }]
          }
        ]
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Spend",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Spent today",
      "description": "What the gateway has spent on models since midnight UTC, against the day’s cap: at the cap it refuses every paid call until the day ends.",
      "gridPos": { "x": 0, "y": 9, "w": 6, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(gateway_cap_spent_usd{cap=\"day\"})",
          "instant": true,
          "range": false,
          "legendFormat": "spent"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(gateway_cap_limit_usd{cap=\"day\"})",
          "instant": true,
          "range": false,
          "legendFormat": "cap"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "transformations": [
        {
          "id": "configFromData",
          "options": { "configRefId": "B", "mappings": [{ "fieldName": "cap", "handlerKey": "max" }] }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "noValue": "The gateway is not reporting",
          "min": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "#0ca30c", "value": null },
