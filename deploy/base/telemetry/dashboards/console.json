{
  "uid": "console",
  "title": "Console",
  "description": "The console’s requests, latency, event stream, logs and traces.",
  "tags": ["software-factory"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": ["software-factory"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests per second",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"software-factory/console\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "noValue": "No requests in this range" },
        "overrides": []
      },
      "description": "Requests the console answered a second. It serves Martin and anyone watching the line, so a few a minute is normal."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Server errors",
      "description": "The share of the console’s responses with a 5xx status. Good is none.",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"software-factory/console\", http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_seconds_count{job=\"software-factory/console\"}[$__rate_interval])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 1, "noValue": "No requests in this range" },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latency, 95th percentile",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"software-factory/console\"}[$__rate_interval])))"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "noValue": "No requests in this range" },
        "overrides": []
      },
      "description": "How long the slowest 5% of the console’s responses took. Good is well under a second."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"software-factory/console\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "noValue": "No requests in this range" }, "overrides": [] },
      "description": "The console’s requests a second, by the status it answered with. Anything in the 5xx range is a fault."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"software-factory/console\"}[$__rate_interval])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"software-factory/console\"}[$__rate_interval])))",
          "legendFormat": "95th percentile"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "No requests in this range" }, "overrides": [] },
      "description": "How long the console took to answer: the median and the 95th percentile."
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Browsers following the line",
      "description": "Browsers connected to the event stream now.",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(console_stream_clients{job=\"software-factory/console\"})" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "noValue": "The console is not reporting" },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Events sent to browsers",
      "description": "Events written to event streams a second, backlogs included.",
      "gridPos": { "x": 6, "y": 12, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(console_stream_events_total{job=\"software-factory/console\"}[$__rate_interval]))",
          "legendFormat": "events"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "noValue": "No events sent in this range" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "From append to browser",
      "description": "Time from an event being appended to the store to its being sent to a browser. The target is under a second.",
      "gridPos": { "x": 15, "y": 12, "w": 9, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(console_stream_delay_seconds_bucket{job=\"software-factory/console\"}[$__rate_interval])))",
          "legendFormat": "median"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(console_stream_delay_seconds_bucket{job=\"software-factory/console\"}[$__rate_interval])))",
          "legendFormat": "95th percentile"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "No events sent in this range" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Logs",
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "refId": "A", "expr": "{service_name=\"console\"}" }],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "description": "What the console said about itself, newest first; a line with a trace opens it."
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent traces",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=\"console\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "The console’s latest traces, newest first; select one to open its spans. Tempo searches a day at most.",
      "fieldConfig": { "defaults": { "noValue": "No traces in this range" }, "overrides": [] }
    }
  ]
}
