    {
      "id": 6,
      "type": "stat",
      "title": "Pending",
      "description": "Alerts whose condition holds but has not yet held for as long as their rule asks: firing soon unless it clears. Good is none.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"pending\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
