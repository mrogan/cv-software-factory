      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Reaching the phone",
      "description": "Whether Alertmanager sends the alerts with a level to Martin's phone: No while PhoneOff fires, which it does while the admin service and the line both say the console's switch is off, as it is by default on the local profile; this dashboard shows every alert either way. Yes while either says nothing, so alerts fail loud. Switching the phone itself always reaches it.",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (count(ALERTS{alertname=\"PhoneOff\", alertstate=\"firing\"}) or vector(0))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No answer from Prometheus",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "#fab219",
                  "index": 0
                },
                "1": {
                  "text": "Yes",
                  "color": "#0ca30c",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Every alert now",
      "description": "Every alert Prometheus has now, firing or pending, whatever its level: its name, state and level, then its labels. An alert with no level reaches no one; the app's objective alerts (an objective, a route) go to the intake. Inhibited alerts are here too: Alertmanager mutes them, Prometheus still has them.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "k8s_namespace_name": true,
              "k8s_pod_label_app_kubernetes_io_name": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "level": 2
            },
            "renameByName": {
              "alertname": "Alert",
              "alertstate": "State",
              "level": "Level"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "State"
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No alert is firing or pending",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "firing",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "pending": {
                        "text": "pending",
                        "color": "#fab219",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Level"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "": {
                        "text": "none",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Alerts over the range",
      "description": "When each alert was pending (amber) and firing (red) over the range, by name, whatever its level: what reached Martin's phone, and what would have. Blank is neither.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (alertname) (ALERTS{alertstate=\"firing\"}) * 2 or max by (alertname) (ALERTS{alertstate=\"pending\"})",
          "legendFormat": "{{alertname}}",
          "interval": "1m"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No alert fired or was pending in this range",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              },
              {
                "color": "#d03b3b",
                "value": 2
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "pending",
                  "index": 0
                },
                "2": {
                  "text": "firing",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      }
    }
  ]
}
