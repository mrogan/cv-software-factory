{
  "uid": "website",
  "title": "The World's Worst Website",
  "description": "Is the app meeting its objectives, and if not, which route and since when? Its error ratio and latency by route against the alerts’ 5% and 1 s, the alerts, the error budget and how fast it burns; then the canary against the stable version, its traffic, what visitors report, and its logs and traces.",
  "tags": ["software-factory"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": ["software-factory"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": false,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Releases",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#9085e9",
        "expr": "sum by (outcome) (changes(line_releases_total{dry_run=\"false\"}[2m])) > 0",
        "step": "1m",
        "titleFormat": "Release {{outcome}}",
        "textFormat": "The line recorded a release’s end",
        "tagKeys": "outcome",
        "useValueForTime": false
      },
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#3987e5",
        "expr": "sum by (name) (changes(argocd_app_sync_total{name=\"website\", phase=\"Succeeded\"}[2m])) > 0",
        "step": "1m",
        "titleFormat": "Argo CD synced {{name}}",
        "textFormat": "",
        "tagKeys": "name",
        "useValueForTime": false
      },
      {
        "name": "The Rollout",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#199e70",
        "expr": "sum by (reason) (changes(rollout_events_total{namespace=\"website\", name=\"website\", reason=~\"RolloutUpdated|RolloutCompleted|RolloutAborted|AnalysisRunFailed\"}[2m])) > 0",
        "step": "1m",
        "titleFormat": "{{reason}}",
        "textFormat": "Argo Rollouts, for the app",
        "tagKeys": "reason",
        "useValueForTime": false
      },
      {
        "name": "The app’s alerts",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertstate=\"firing\", objective!=\"\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{route}}",
        "tagKeys": "objective,route",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "label": "Route",
        "description": "A route, or all of them",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 1,
          "query": "label_values(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}, http_route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{job=\"worlds-worst-website/website\", k8s_pod_label_rollouts_pod_template_hash!=\"\", http_route!=\"\"}, http_route)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Objectives",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Errors, worst route",
      "description": "The share of requests answered with a 5xx status over 15 minutes, on the route with the most, among routes with at least 20 requests: what the error alert judges. Good is under the objective, 5%.",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(website:route_errors:ratio_rate15m)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 0.025 },
              { "color": "#d03b3b", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95, slowest route",
      "description": "The 95th percentile of response time over 15 minutes, on the slowest route with at least 20 requests: what the latency alert judges. Good is under the objective, 1 s.",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(website:route_latency_seconds:p95_rate15m)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#fab219", "value": 0.5 },
              { "color": "#d03b3b", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts firing",
      "description": "The app’s alerts firing now, one for each route and objective broken for two minutes. Good is none; the timeline below says which.",
      "gridPos": { "x": 8, "y": 1, "w": 3, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\", objective!=\"\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No answer from Prometheus",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "#0ca30c", "value": 0 },
              { "color": "#d03b3b", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Error budget left, 7 days",
      "description": "How much of each objective’s error budget the last seven days left: 5% of requests may fail, and 5% may be slower than 1 s. 100% is all of it; below 0 is overspent. The app is broken on purpose, so it is overspent while its faults stand.",
      "gridPos": { "x": 11, "y": 1, "w": 5, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_remaining:ratio7d",
          "legendFormat": "{{objective}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "noValue": "No requests in 7 days",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#d03b3b", "value": null },
              { "color": "#fab219", "value": 0 },
              { "color": "#0ca30c", "value": 0.25 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Burn rate, 1 h",
      "description": "How fast each objective spent its budget over the last hour, against the pace that would spend a week’s budget in a week: 1 is that pace, 2 would spend it in half a week. Good is under 1. An hour reacts fast and forgets fast; read it with the six hours beside it.",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_burn:rate1h",
          "legendFormat": "{{objective}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "noValue": "No requests in the hour",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Burn rate, 6 h",
      "description": "How fast each objective spent its budget over the last six hours, against the pace that would spend a week’s budget in a week. Good is under 1. High here and low over the hour is a fault that has stopped; high in both is one still burning.",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_burn:rate6h",
          "legendFormat": "{{objective}}"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "decimals": 1,
          "noValue": "No requests in six hours",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Errors by route, over 15 minutes",
      "description": "Each route’s share of 5xx answers over the 15 minutes before each point, among routes with at least 20 requests in them: the line the error alert draws. The dashed line is the objective, 5%; a route above it for two minutes fires the alert. The legend puts the worst first.",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:route_errors:ratio_rate15m{http_route=~\"$route\"}",
          "legendFormat": "{{http_route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["max"],
          "sortBy": "Max",
          "sortDesc": true,
          "width": 260
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }, { "color": "#d03b3b", "value": 0.05 }]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "scheme",
            "axisSoftMax": 0.06,
            "thresholdsStyle": { "mode": "dashed" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p95 by route, over 15 minutes",
      "description": "Each route’s 95th percentile of response time over the 15 minutes before each point, among routes with at least 20 requests in them: the line the latency alert draws. The dashed line is the objective, 1 s. The legend puts the slowest first.",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:route_latency_seconds:p95_rate15m{http_route=~\"$route\"}",
          "legendFormat": "{{http_route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": ["max"],
          "sortBy": "Max",
          "sortDesc": true,
          "width": 260
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "noValue": "No route had 20 requests",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }, { "color": "#d03b3b", "value": 1 }]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "scheme",
            "axisSoftMax": 1.2,
            "thresholdsStyle": { "mode": "dashed" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Each route now",
      "description": "Every route’s last 15 minutes against the objectives, worst first: its requests, its share of 5xx answers and its 95th percentile. A route with fewer than 20 requests is not judged, as the alerts do not judge it. Select a route to narrow the dashboard to it.",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "round(website:route_requests:increase15m{http_route=~\"$route\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (http_route) (website:route_errors:ratio_rate15m{http_route=~\"$route\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (http_route) (website:route_latency_seconds:p95_rate15m{http_route=~\"$route\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": {
              "http_route": "Route",
              "Value #A": "Requests, 15 min",
              "Value #B": "Errors",
              "Value #C": "p95"
            }
          }
        }
      ],
      "options": { "showHeader": true, "cellHeight": "sm", "sortBy": [{ "displayName": "Errors", "desc": true }] },
      "fieldConfig": {
        "defaults": { "unit": "none", "noValue": "No requests in 15 minutes", "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*" }, "properties": [{ "id": "noValue", "value": "—" }] },
          {
            "matcher": { "id": "byName", "options": "Route" },
            "properties": [
              {
                "id": "links",
                "value": [{ "title": "This route", "url": "/d/website?var-route=${__value.raw}&${__url_time_range}" }]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Requests, 15 min" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "#898781", "value": null }, { "color": "text", "value": 20 }]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 0.025 },
                    { "color": "#d03b3b", "value": 0.05 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 0.5 },
                    { "color": "#d03b3b", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "The app’s alerts",
      "description": "Each alert over the range on the route chosen above, by route: pending while its objective is broken but not yet for two minutes, firing after. While none is either, one green row says so.",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (alertname, route) (2 * ALERTS{alertstate=\"firing\", objective!=\"\", route=~\"$route\"} or ALERTS{alertstate=\"pending\", objective!=\"\", route=~\"$route\"}) or on () label_replace(vector(0), \"alertname\", \"No alert\", \"\", \"\")",
          "legendFormat": "{{alertname}} {{route}}"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "No alert pending or firing in this range",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 1 },
              { "color": "#d03b3b", "value": 2 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "None pending or firing", "color": "#0ca30c", "index": 0 },
                "1": { "text": "Pending", "color": "#fab219", "index": 1 },
                "2": { "text": "Firing", "color": "#d03b3b", "index": 2 }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Burn rate, 1 h and 6 h",
      "description": "How fast each objective spent its error budget over the hour and the six hours before each point, against the pace that spends a week’s budget in a week, the dashed line at 1. Above it, the budget runs out before the week does.",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "5m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_burn:rate1h",
          "legendFormat": "{{objective}}, 1 h"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "website:error_budget_burn:rate6h",
          "legendFormat": "{{objective}}, 6 h"
        }
      ],
      "options": {
