          "unit": "suffix:×",
          "decimals": 1,
          "min": 0,
          "noValue": "No requests in this range",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "transparent", "value": null }, { "color": "#d03b3b", "value": 1 }]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
