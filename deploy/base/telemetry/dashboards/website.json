      "id": 22,
      "type": "bargauge",
      "title": "Most 4xx, by route",
      "description": "The ten routes that answered 4xx most in the range. A request that matched no route is “no route”: a broken link, or someone guessing.",
      "gridPos": { "x": 18, "y": 40, "w": 6, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
