    {
      "id": 14,
      "type": "row",
      "title": "Canary and stable",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 15,
      "type": "state-timeline",
      "title": "The app’s Rollout",
      "description": "Where the app’s Rollout was over the range: stable, a canary in progress, or a canary aborted, which Argo Rollouts does when its analysis fails. Good is stable, or a canary on its way.",
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 3 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(rollout_phase{namespace=\"website\", name=\"website\", phase=~\"Progressing|Paused\"}) + 2 * max(rollout_phase{namespace=\"website\", name=\"website\", phase=~\"Abort|Error|Timeout\"})",
          "legendFormat": "Rollout"
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Argo Rollouts not reporting",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#898781", "value": 1 },
              { "color": "#d03b3b", "value": 2 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Stable", "color": "#0ca30c", "index": 0 },
                "1": { "text": "Canary", "color": "#898781", "index": 1 },
                "2": { "text": "Aborted", "color": "#d03b3b", "index": 2 },
                "3": { "text": "Aborted", "color": "#d03b3b", "index": 3 }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Requests, stable and canary",
      "description": "Requests a second through Traefik to the app’s stable version and to its canary: the split a release’s canary analysis judges. Traefik counts everyone’s, the probes’ and the crawler’s too. Outside a release, the canary has none.",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traefik_service_requests_total{service=\"website-website-80@kubernetescrd\"}[$__rate_interval]))",
          "legendFormat": "stable"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(traefik_service_requests_total{service=\"website-website-canary-80@kubernetescrd\"}[$__rate_interval]))",
          "legendFormat": "canary"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "min": 0,
          "noValue": "Traefik not reporting",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3987e5", "value": null }] },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "stable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "canary" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }]
          }
        ]
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Server errors, stable and canary",
      "description": "The share of requests through Traefik answered with a 5xx status, by the stable version and the canary. A canary well above the stable version is one its analysis should stop. The dashed line is the objective, 5%.",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "2m",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(traefik_service_requests_total{service=\"website-website-80@kubernetescrd\", code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(traefik_service_requests_total{service=\"website-website-80@kubernetescrd\"}[$__rate_interval])) > 0)",
          "legendFormat": "stable"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(traefik_service_requests_total{service=\"website-website-canary-80@kubernetescrd\", code=~\"5..\"}[$__rate_interval])) or vector(0)) / (sum(rate(traefik_service_requests_total{service=\"website-website-canary-80@kubernetescrd\"}[$__rate_interval])) > 0)",
          "legendFormat": "canary"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "noValue": "Traefik not reporting",
          "color": { "mode": "fixed", "fixedColor": "#3987e5" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "transparent", "value": null }, { "color": "#d03b3b", "value": 0.05 }]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMax": 0.06,
            "thresholdsStyle": { "mode": "dashed" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "stable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } }]
          },
          {
            "matcher": { "id": "byName", "options": "canary" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d95926" } }]
          }
        ]
      }
