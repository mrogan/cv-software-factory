{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!docs", "!.release-please-manifest.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "postgres": {
                "importNames": ["default"],
                "message": "Make the store's client with connect() from @software-factory/store, which counts its queries and connections."
              }
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/store/src/client.ts", "**/test/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
